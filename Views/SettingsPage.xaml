<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayGit.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TrayGit.ViewModels"
    x:DefaultBindMode="OneWay"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="BackButton"
                Margin="-8,0,0,0"
                AutomationProperties.AutomationId="settings-back"
                AutomationProperties.Name="Back"
                Command="{x:Bind ViewModel.BackCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Back">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Settings" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,0,-4,0">
            <StackPanel Margin="0,0,4,0" Spacing="4">
                <StackPanel
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Source folder" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SourceFolderText}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="BrowseButton"
                        AutomationProperties.AutomationId="source-folder-browse"
                        AutomationProperties.Name="Choose source folder"
                        Click="BrowseButton_Click"
                        Content="Choose folder" />
                </StackPanel>

                <Grid
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    ColumnSpacing="12"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.StartupDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Grid.Column="1"
                        MinWidth="0"
                        AutomationProperties.AutomationId="startup-toggle"
                        AutomationProperties.Name="Start with Windows"
                        IsEnabled="{x:Bind ViewModel.StartupToggleEnabled}"
                        IsOn="{x:Bind ViewModel.StartupEnabled, Mode=TwoWay}"
                        OffContent=""
                        OnContent="" />
                </Grid>

                <StackPanel
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Global hotkey" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.HotKeyDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.AutomationId="hotkey-toggle"
                            AutomationProperties.Name="Global hotkey"
                            IsOn="{x:Bind ViewModel.HotKeyEnabled, Mode=TwoWay}"
                            OffContent=""
                            OnContent=""
                            Toggled="HotKeyToggle_Toggled" />
                    </Grid>
                    <Button
                        x:Name="HotKeyButton"
                        AutomationProperties.AutomationId="hotkey-capture"
                        AutomationProperties.Name="Change hotkey"
                        Command="{x:Bind ViewModel.BeginHotKeyCaptureCommand}"
                        Content="{x:Bind ViewModel.HotKeyButtonText}"
                        IsEnabled="{x:Bind ViewModel.HotKeyCaptureEnabled}"
                        LostFocus="HotKeyButton_LostFocus"
                        PreviewKeyDown="HotKeyButton_PreviewKeyDown" />
                </StackPanel>

                <StackPanel
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Spacing="8">
                    <StackPanel>
                        <TextBlock Text="Row buttons" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Choose the buttons shown on each repo and drag the handles to reorder them. The AI tools open a terminal in the repo and start the tool."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView
                        AutomationProperties.AutomationId="row-actions-list"
                        AllowDrop="True"
                        CanDragItems="True"
                        CanReorderItems="True"
                        DragItemsCompleted="ActionsList_DragItemsCompleted"
                        IsItemClickEnabled="False"
                        ItemsSource="{x:Bind ViewModel.Actions}"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ActionSettingViewModel">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Drag to reorder"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE700;"
                                        ToolTipService.ToolTip="Drag to reorder" />
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        AutomationProperties.AutomationId="{x:Bind Id}"
                                        Content="{x:Bind Name}"
                                        IsChecked="{x:Bind IsShown, Mode=TwoWay}" />
                                    <Button
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="{x:Bind RemoveAutomationName}"
                                        AutomationProperties.Name="{x:Bind RemoveAutomationName}"
                                        Command="{x:Bind RemoveCommand}"
                                        Style="{StaticResource FlyoutIconButtonStyle}"
                                        ToolTipService.ToolTip="Remove"
                                        Visibility="{x:Bind IsCustom}">
                                        <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Add a custom action" />
                    <TextBox
                        AutomationProperties.AutomationId="custom-action-name"
                        AutomationProperties.Name="Custom action name"
                        PlaceholderText="Name, such as Aider"
                        Text="{x:Bind ViewModel.CustomActionName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        AutomationProperties.AutomationId="custom-action-command"
                        AutomationProperties.Name="Custom action command"
                        PlaceholderText="Command, such as aider"
                        Text="{x:Bind ViewModel.CustomActionCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        AutomationProperties.AutomationId="custom-action-add"
                        Command="{x:Bind ViewModel.AddActionCommand}"
                        Content="Add" />
                </StackPanel>

                <StackPanel
                    Padding="16,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Spacing="8">
                    <TextBlock Text="Interaction" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="enter-action"
                        AutomationProperties.Name="Enter does"
                        DisplayMemberPath="Name"
                        Header="Enter"
                        ItemsSource="{x:Bind ViewModel.ActionChoices}"
                        SelectedItem="{x:Bind ViewModel.EnterAction, Mode=TwoWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="click-action"
                        AutomationProperties.Name="Click does"
                        DisplayMemberPath="Name"
                        Header="Click"
                        ItemsSource="{x:Bind ViewModel.ActionChoices}"
                        SelectedItem="{x:Bind ViewModel.ClickAction, Mode=TwoWay}" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="double-click-action"
                        AutomationProperties.Name="Double-click does"
                        DisplayMemberPath="Name"
                        Header="Double-click"
                        ItemsSource="{x:Bind ViewModel.ActionChoices}"
                        SelectedItem="{x:Bind ViewModel.DoubleClickAction, Mode=TwoWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="With both click and double-click set, a click waits a moment to see whether a second one follows."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.VersionText}" />
    </Grid>
</Page>
