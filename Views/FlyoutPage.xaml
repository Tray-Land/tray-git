<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayGit.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:TrayGit.ViewModels"
    xmlns:views="using:TrayGit.Views"
    x:DefaultBindMode="OneWay"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="{x:Bind ViewModel.DisplayName}" />
            <ToggleButton
                x:Name="FavoritesToggle"
                Grid.Column="1"
                AutomationProperties.AutomationId="favorites-toggle"
                AutomationProperties.Name="Show only favorites"
                IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}"
                Style="{StaticResource FlyoutIconToggleButtonStyle}"
                ToolTipService.ToolTip="Show only favorites"
                Visibility="{x:Bind ViewModel.IsConfigured}">
                <FontIcon FontSize="14" Glyph="{x:Bind ViewModel.FavoritesGlyph}" />
            </ToggleButton>
            <ToggleButton
                x:Name="DirtyToggle"
                Grid.Column="2"
                AutomationProperties.AutomationId="dirty-toggle"
                AutomationProperties.Name="Show only dirty repos"
                IsChecked="{x:Bind ViewModel.DirtyOnly, Mode=TwoWay}"
                Style="{StaticResource FlyoutIconToggleButtonStyle}"
                ToolTipService.ToolTip="Show only dirty repos"
                Visibility="{x:Bind ViewModel.IsConfigured}">
                <FontIcon FontSize="14" Glyph="&#xE70F;" />
            </ToggleButton>
            <Button
                x:Name="RefreshButton"
                Grid.Column="3"
                AutomationProperties.AutomationId="rescan-button"
                AutomationProperties.Name="Rescan source folder"
                Command="{x:Bind ViewModel.RefreshCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Rescan source folder"
                Visibility="{x:Bind ViewModel.IsConfigured}">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="4"
                AutomationProperties.AutomationId="settings-button"
                AutomationProperties.Name="Settings"
                Command="{x:Bind ViewModel.ShowSettingsCommand}"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.AutomationId="repo-search"
            AutomationProperties.Name="Filter repos"
            IsEnabled="{x:Bind ViewModel.IsConfigured}"
            PlaceholderText="{x:Bind ViewModel.SearchPlaceholder}"
            PreviewKeyDown="SearchBox_PreviewKeyDown"
            QueryIcon="Find"
            QuerySubmitted="SearchBox_QuerySubmitted"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <InfoBar
            Grid.Row="2"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.IsStatusOpen}"
            Message="{x:Bind ViewModel.StatusMessage}"
            Severity="Warning"
            Title="{x:Bind ViewModel.StatusTitle}" />

        <ListView
            x:Name="RepoList"
            Grid.Row="3"
            Margin="-12,0,-8,0"
            AutomationProperties.AutomationId="repo-list"
            GotFocus="RepoList_GotFocus"
            IsItemClickEnabled="False"
            ItemsSource="{x:Bind ViewModel.Repositories}"
            LostFocus="RepoList_LostFocus"
            PreviewKeyDown="RepoList_PreviewKeyDown"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0,4,0" />
                    <Setter Property="MinHeight" Value="52" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RepoItemViewModel">
                    <SwipeControl>
                        <SwipeControl.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Command="{x:Bind FetchCommand}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Text="Fetch">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE895;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                                <SwipeItem
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Command="{x:Bind ToggleFavoriteCommand}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{x:Bind Repo.FavoriteActionText}">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE734;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.RightItems>
                        <Grid
                            Padding="0,6"
                            AutomationProperties.Name="{x:Bind Repo.Name}"
                            Background="Transparent"
                            ColumnSpacing="2"
                            DoubleTapped="RepoRow_DoubleTapped"
                            PointerEntered="RepoRow_PointerEntered"
                            PointerExited="RepoRow_PointerExited"
                            Tapped="RepoRow_Tapped">
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-details"
                                        Command="{x:Bind ViewDetailsCommand}"
                                        Text="View details">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-fetch"
                                        Command="{x:Bind FetchCommand}"
                                        Text="Fetch">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE895;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-pull"
                                        Command="{x:Bind PullCommand}"
                                        Text="Pull">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE896;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-push"
                                        Command="{x:Bind PushCommand}"
                                        Text="Push">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE898;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-copy-path"
                                        Command="{x:Bind CopyPathCommand}"
                                        Text="Copy as path">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE8C8;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        AutomationProperties.AutomationId="repo-favorite"
                                        Command="{x:Bind ToggleFavoriteCommand}"
                                        Text="{x:Bind Repo.FavoriteActionText}">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE734;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                                <TextBlock
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Repo.Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    ToolTipService.ToolTip="{x:Bind Repo.Path}" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE735;"
                                    ToolTipService.ToolTip="Favorite"
                                    Visibility="{x:Bind Repo.IsFavorite}" />
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    MaxWidth="150"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Repo.BranchText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Repo.AddedText}"
                                        Visibility="{x:Bind Repo.HasAdded}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Repo.RemovedText}"
                                        Visibility="{x:Bind Repo.HasRemoved}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Repo.BehindText}"
                                        ToolTipService.ToolTip="Commits to pull"
                                        Visibility="{x:Bind Repo.HasBehind}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Repo.AheadText}"
                                        ToolTipService.ToolTip="Commits to push"
                                        Visibility="{x:Bind Repo.HasAhead}" />
                                    <ProgressRing
                                        Width="12"
                                        Height="12"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind Repo.IsFetching}"
                                        Visibility="{x:Bind Repo.IsFetching}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Repo.ParentCaption}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                            <StackPanel
                                Canvas.ZIndex="1"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="2">
                                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind Actions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="viewModels:RepoActionViewModel">
                                            <Button
                                                AutomationProperties.AutomationId="{x:Bind Action.Id}"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                Command="{x:Bind RunCommand}"
                                                IsEnabled="{x:Bind IsEnabled}"
                                                Opacity="{x:Bind Opacity}"
                                                Style="{StaticResource FlyoutIconButtonStyle}"
                                                ToolTipService.ToolTip="{x:Bind Tooltip}">
                                                <Grid>
                                                    <Image
                                                        Width="16"
                                                        Height="16"
                                                        Source="{x:Bind views:ActionIcons.For(Image)}"
                                                        Visibility="{x:Bind HasImage}" />
                                                    <FontIcon
                                                        FontSize="14"
                                                        Glyph="{x:Bind Glyph}"
                                                        Visibility="{x:Bind HasGlyph}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind Badge}"
                                                        Visibility="{x:Bind HasBadge}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    AutomationProperties.AutomationId="repo-details-button"
                                    AutomationProperties.Name="View repo details"
                                    Command="{x:Bind ViewDetailsCommand}"
                                    Style="{StaticResource FlyoutIconButtonStyle}"
                                    ToolTipService.ToolTip="View repo details">
                                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </SwipeControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="3"
            MaxWidth="280"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty}">
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyText}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="choose-folder-empty"
                Command="{x:Bind ViewModel.ChooseFolderCommand}"
                Content="Choose source folder"
                Style="{StaticResource AccentButtonStyle}"
                Visibility="{x:Bind ViewModel.NeedsConfiguration}" />
        </StackPanel>

        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.UpdatedText}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <ProgressRing
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="{x:Bind ViewModel.IsLoading}" />
        </Grid>
    </Grid>
</Page>
