<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="TrayGit.Views.FlyoutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:TrayGit.Core"
    Background="Transparent">

    <Grid Padding="16,12,12,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="TitleText"
                VerticalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Tray Git" />
            <ToggleButton
                x:Name="FavoritesToggle"
                Grid.Column="1"
                AutomationProperties.Name="Show only favorites"
                Checked="FavoritesToggle_Changed"
                Style="{StaticResource FlyoutIconToggleButtonStyle}"
                ToolTipService.ToolTip="Show only favorites"
                Unchecked="FavoritesToggle_Changed">
                <FontIcon x:Name="FavoritesToggleIcon" FontSize="14" Glyph="&#xE734;" />
            </ToggleButton>
            <Button
                x:Name="RefreshButton"
                Grid.Column="2"
                AutomationProperties.Name="Rescan source folder"
                Click="RefreshButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Rescan source folder">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
            <Button
                Grid.Column="3"
                AutomationProperties.Name="Settings"
                Click="SettingsButton_Click"
                Style="{StaticResource FlyoutIconButtonStyle}"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>

        <AutoSuggestBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.Name="Filter repos"
            PlaceholderText="Filter repos, Enter opens a terminal"
            PreviewKeyDown="SearchBox_PreviewKeyDown"
            QueryIcon="Find"
            QuerySubmitted="SearchBox_QuerySubmitted"
            TextChanged="SearchBox_TextChanged" />

        <!--  Errors keep the last good list visible underneath  -->
        <InfoBar
            x:Name="StatusBar"
            Grid.Row="2"
            IsClosable="False"
            IsOpen="False"
            Severity="Warning" />

        <ListView
            x:Name="RepoList"
            Grid.Row="3"
            Margin="-12,0,-8,0"
            IsItemClickEnabled="False"
            PreviewKeyDown="RepoList_PreviewKeyDown"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Padding" Value="12,0,4,0" />
                    <Setter Property="MinHeight" Value="52" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="core:GitRepo">
                    <!--  Swipe left (touch or pen) to reveal Fetch; right-click does the same with a mouse  -->
                    <SwipeControl>
                        <SwipeControl.RightItems>
                            <SwipeItems Mode="Reveal">
                                <SwipeItem
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Invoked="FetchSwipeItem_Invoked"
                                    Text="Fetch">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE895;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                                <SwipeItem
                                    Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Invoked="FavoriteSwipeItem_Invoked"
                                    Text="{x:Bind FavoriteActionText, Mode=OneWay}">
                                    <SwipeItem.IconSource>
                                        <FontIconSource Glyph="&#xE734;" />
                                    </SwipeItem.IconSource>
                                </SwipeItem>
                            </SwipeItems>
                        </SwipeControl.RightItems>
                    <Grid
                        Padding="0,6"
                        AutomationProperties.Name="{x:Bind Name}"
                        Background="Transparent"
                        ColumnSpacing="2"
                        DoubleTapped="RepoRow_DoubleTapped"
                        ToolTipService.ToolTip="{x:Bind Path}">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem
                                    Click="FetchMenuItem_Click"
                                    IsEnabled="{x:Bind CanFetch, Mode=OneWay}"
                                    Tag="{x:Bind}"
                                    Text="Fetch">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE895;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="CopyPathMenuItem_Click"
                                    Tag="{x:Bind}"
                                    Text="Copy as path">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    Click="FavoriteMenuItem_Click"
                                    Tag="{x:Bind}"
                                    Text="{x:Bind FavoriteActionText, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE734;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock
                                    MaxWidth="240"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Name}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                    Glyph="&#xE735;"
                                    ToolTipService.ToolTip="Favorite"
                                    Visibility="{x:Bind IsFavorite, Mode=OneWay}" />
                            </StackPanel>
                            <!--  Branch, then the status segment, then the parent folder  -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    MaxWidth="150"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind BranchText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                                <StackPanel
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind AddedText, Mode=OneWay}"
                                        Visibility="{x:Bind HasAdded, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind RemovedText, Mode=OneWay}"
                                        Visibility="{x:Bind HasRemoved, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind BehindText, Mode=OneWay}"
                                        ToolTipService.ToolTip="Commits to pull"
                                        Visibility="{x:Bind HasBehind, Mode=OneWay}" />
                                    <TextBlock
                                        Margin="6,0,0,0"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind AheadText, Mode=OneWay}"
                                        ToolTipService.ToolTip="Commits to push"
                                        Visibility="{x:Bind HasAhead, Mode=OneWay}" />
                                    <ProgressRing
                                        Width="12"
                                        Margin="6,0,0,0"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        IsActive="{x:Bind IsFetching, Mode=OneWay}"
                                        Visibility="{x:Bind IsFetching, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="6,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind ParentCaption}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            AutomationProperties.Name="Open terminal"
                            Click="TerminalButton_Click"
                            Style="{StaticResource FlyoutIconButtonStyle}"
                            ToolTipService.ToolTip="Open terminal">
                            <FontIcon FontSize="14" Glyph="&#xE756;" />
                        </Button>
                        <Button
                            Grid.Column="2"
                            AutomationProperties.Name="Open folder"
                            Click="FolderButton_Click"
                            Style="{StaticResource FlyoutIconButtonStyle}"
                            ToolTipService.ToolTip="Open folder">
                            <FontIcon FontSize="14" Glyph="&#xE838;" />
                        </Button>
                        <Button
                            Grid.Column="3"
                            AutomationProperties.Name="Open remote"
                            Click="RemoteButton_Click"
                            IsEnabled="{x:Bind HasWebUrl}"
                            Style="{StaticResource FlyoutIconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind RemoteTooltip}">
                            <FontIcon FontSize="14" Glyph="&#xE774;" />
                        </Button>
                    </Grid>
                    </SwipeControl>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty / not configured  -->
        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="3"
            MaxWidth="280"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                x:Name="EmptyText"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Name="ChooseFolderButton"
                HorizontalAlignment="Center"
                Click="ChooseFolderButton_Click"
                Content="Choose source folder"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <!--  Footer  -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="UpdatedText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <ProgressRing
                x:Name="LoadingRing"
                Grid.Column="1"
                Width="16"
                Height="16"
                IsActive="False" />
        </Grid>
    </Grid>
</Page>
